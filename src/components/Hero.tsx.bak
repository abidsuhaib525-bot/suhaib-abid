"use client";

import { useRef, useEffect, useState } from "react";
import Image from "next/image";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

const phrases = [
  "BUILDING IMMERSIVE DIGITAL EXPERIENCES.",
  "DESIGNING CINEMATIC USER INTERFACES.",
  "ENGINEERING SECURE, FAST SYSTEMS."
];

export function Hero() {
  const containerRef = useRef<HTMLElement>(null);
  const imageRef = useRef<HTMLDivElement>(null);
  const contentRef = useRef<HTMLDivElement>(null);
  const nameRef1 = useRef<HTMLHeadingElement>(null);
  const nameRef2 = useRef<HTMLHeadingElement>(null);
  const particlesRef = useRef<HTMLDivElement>(null);
  const portalGlowRef = useRef<HTMLDivElement>(null);
  
  // Rotating Typewriter State
  const [text, setText] = useState("");
  const [isDeleting, setIsDeleting] = useState(false);
  const [loopNum, setLoopNum] = useState(0);
  const [typingSpeed, setTypingSpeed] = useState(50);
  const [hasStarted, setHasStarted] = useState(false);

  useEffect(() => {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
    
    tl.fromTo(imageRef.current, { scale: 1.05, opacity: 0 }, { scale: 1, opacity: 1, duration: 2.5 })
      .fromTo(".nav-reveal", { y: -20, opacity: 0 }, { y: 0, opacity: 1, duration: 1.5 }, "-=2")
      .fromTo(".eyebrow-reveal", { clipPath: "polygon(0 0, 0 0, 0 100%, 0% 100%)" }, { clipPath: "polygon(0 0, 100% 0, 100% 100%, 0% 100%)", duration: 1.5 }, "-=1.5")
      .fromTo(nameRef1.current, { y: 60, opacity: 0, skewY: 2 }, { y: 0, opacity: 1, skewY: 0, duration: 1.5 }, "-=1.2")
      .fromTo(nameRef2.current, { y: 60, opacity: 0, skewY: 2 }, { y: 0, opacity: 1, skewY: 0, duration: 1.5 }, "-=1.3")
      .fromTo(".cta-reveal", { y: 20, opacity: 0 }, { y: 0, opacity: 1, stagger: 0.15, duration: 1.5 }, "-=1.2")
      .fromTo(".scroll-reveal", { opacity: 0 }, { opacity: 1, duration: 2 }, "-=1");

    gsap.to(imageRef.current, {
      scrollTrigger: { trigger: containerRef.current, start: "top top", end: "bottom top", scrub: 1 },
      y: "12%", scale: 1.05, ease: "none",
    });

    gsap.to(contentRef.current, {
      scrollTrigger: { trigger: containerRef.current, start: "top top", end: "bottom top", scrub: 0.5 },
      y: 120, opacity: 0,
    });

    const handleMouseMove = (e: MouseEvent) => {
      if (window.innerWidth < 768) return;
      const x = (e.clientX / window.innerWidth - 0.5) * 2;
      const y = (e.clientY / window.innerHeight - 0.5) * 2;
      
      gsap.to(imageRef.current, { x: x * -15, y: y * -15, duration: 2.5, ease: "power2.out" });
      gsap.to(contentRef.current, { x: x * 10, y: y * 10, duration: 2.5, ease: "power2.out" });
      gsap.to(particlesRef.current, { x: x * -25, y: y * -25, duration: 2.5, ease: "power2.out" });
      gsap.to(portalGlowRef.current, { x: x * -5, y: y * -5, duration: 2.5, ease: "power2.out" });
    };

    window.addEventListener("mousemove", handleMouseMove);
    return () => {
      window.removeEventListener("mousemove", handleMouseMove);
      tl.kill();
    };
  }, []);

  // Delay typing start until GSAP is mostly done
  useEffect(() => {
    const timer = setTimeout(() => setHasStarted(true), 2500);
    return () => clearTimeout(timer);
  }, []);

  // Rotating Typewriter Effect Logic
  useEffect(() => {
    if (!hasStarted) return;
    
    let timer: NodeJS.Timeout;
    
    const handleType = () => {
      const i = loopNum % phrases.length;
      const fullText = phrases[i];

      setText(
        isDeleting
          ? fullText.substring(0, text.length - 1)
          : fullText.substring(0, text.length + 1)
      );

      // Speed up when deleting
      setTypingSpeed(isDeleting ? 30 : 60);

      // Check if word is complete
      if (!isDeleting && text === fullText) {
        // Pause at the end of the word before deleting
        timer = setTimeout(() => setIsDeleting(true), 2000);
        return;
      } else if (isDeleting && text === "") {
        setIsDeleting(false);
        setLoopNum(loopNum + 1);
        setTypingSpeed(50); // slight pause before typing new word
      }
      
      timer = setTimeout(handleType, typingSpeed);
    };

    timer = setTimeout(handleType, typingSpeed);
    return () => clearTimeout(timer);
  }, [text, isDeleting, hasStarted, loopNum, typingSpeed]);

  return (
    <section ref={containerRef} className="relative w-full h-screen overflow-hidden bg-[#030303]">
      
      {/* Background Image */}
      <div ref={imageRef} className="absolute inset-0 z-0 h-[115%] -top-[5%] w-[105%] -left-[2.5%]">
        <Image src="/hero.png" alt="Cinematic Space Landscape" fill priority className="object-cover object-center" />
      </div>

      {/* Subtle Atmospheric Dust */}
      <div ref={particlesRef} className="absolute inset-0 z-0 opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white/10 via-transparent to-transparent bg-[length:30px_30px]" />

      {/* Subtle Portal Breathing Glow */}
      <div ref={portalGlowRef} className="absolute right-0 top-1/2 -translate-y-1/2 w-[800px] h-[800px] z-0 pointer-events-none mix-blend-screen opacity-40 animate-[portalBreathe_8s_ease-in-out_infinite] bg-[radial-gradient(circle_at_center,_rgba(255,255,255,0.15)_0%,_transparent_60%)]" />

      {/* Refined Cinematic Vignette */}
      <div className="absolute inset-0 z-10 w-full md:w-[65%] bg-gradient-to-r from-[#030303] via-[#030303]/80 to-transparent opacity-95 pointer-events-none" />
      <div className="absolute inset-0 z-10 bg-[radial-gradient(circle_at_left_center,_var(--tw-gradient-stops))] from-[#030303]/90 via-transparent to-transparent pointer-events-none" />
      <div className="absolute inset-x-0 bottom-0 z-10 h-[40%] bg-gradient-to-t from-[#030303] via-[#030303]/50 to-transparent pointer-events-none" />

      {/* Extremely Minimal Editorial Line */}
      <div className="absolute left-6 md:left-16 top-0 bottom-0 w-[1px] bg-white/[0.03] z-20 pointer-events-none" />

      {/* Typography Content */}
      <div className="relative z-20 h-full max-w-[1440px] mx-auto px-6 md:px-32 flex flex-col justify-center">
        
        <div ref={contentRef} className="hero-content-wrapper max-w-4xl mt-16 md:mt-24">
          
          <div className="eyebrow-reveal mb-10 flex items-center gap-6 opacity-0">
            <div className="w-6 h-[1px] bg-white"></div>
            <p className="text-white text-[9px] md:text-[10px] font-medium tracking-[0.4em] uppercase">
              Developer <span className="mx-3 opacity-30">•</span> Cybersecurity <span className="mx-3 opacity-30">•</span> Designer
            </p>
          </div>
          
          <div className="flex flex-col gap-2 md:gap-4 mb-12 overflow-hidden">
            <h1 ref={nameRef1} className="font-sans text-[80px] md:text-[130px] lg:text-[180px] font-bold tracking-tight text-white leading-[0.9] opacity-0">
              SUHAIB
            </h1>
            <h1 ref={nameRef2} className="font-sans text-[80px] md:text-[130px] lg:text-[180px] font-bold tracking-tight text-white leading-[0.9] opacity-0">
              ABID
            </h1>
          </div>
          
          {/* Rotating Typewriter */}
          <div className="mb-16 min-h-[20px] max-w-full overflow-hidden flex items-center">
            <p className="text-[12px] md:text-[14px] font-medium tracking-[0.1em] uppercase whitespace-nowrap text-white/50">
              <span>{text}</span>
              <span className="inline-block w-[2px] h-[14px] bg-white/70 ml-1 animate-pulse align-middle"></span>
            </p>
          </div>

          <div className="flex flex-wrap gap-12 items-center">
            <a href="#projects" className="cta-reveal group relative flex items-center justify-center px-8 py-4 border border-white/20 rounded-sm text-[10px] font-medium tracking-[0.2em] uppercase text-white transition-all duration-500 overflow-hidden hover:border-white/40 hover:bg-white/[0.02] opacity-0">
              <span className="relative z-10 transition-transform duration-500 group-hover:-translate-y-px">Explore Work</span>
              <span className="relative z-10 ml-4 transform group-hover:translate-x-1 transition-transform duration-300 opacity-80">→</span>
            </a>
            
            <a href="#contact" className="cta-reveal group flex items-center text-[10px] font-medium tracking-[0.2em] uppercase text-white/40 hover:text-white transition-colors duration-500 relative py-2 opacity-0">
              <span className="relative z-10">Contact Me</span>
              <div className="absolute bottom-0 left-0 w-0 h-[1px] bg-white/40 group-hover:w-full transition-all duration-700 ease-out"></div>
            </a>
          </div>
        </div>
      </div>

      {/* Refined Minimal Scroll Indicator */}
      <div className="scroll-reveal absolute bottom-12 left-6 md:left-32 z-20 flex flex-col gap-5 opacity-0">
        <span className="text-[7.5px] uppercase tracking-[0.5em] font-medium text-white/20">Scroll</span>
        <div className="w-12 h-[1px] bg-white/10 relative overflow-hidden">
          <div className="absolute top-0 left-0 h-full w-full bg-white/50 -translate-x-full animate-[scrollLine_3s_ease-in-out_infinite]"></div>
        </div>
      </div>
      
      <style dangerouslySetInnerHTML={{__html: `
        @keyframes scrollLine {
          0% { transform: translateX(-100%); }
          50% { transform: translateX(0%); }
          100% { transform: translateX(100%); }
        }
        @keyframes portalBreathe {
          0%, 100% { opacity: 0.3; transform: scale(1); }
          50% { opacity: 0.5; transform: scale(1.05); }
        }
      `}} />
    </section>
  );
}
